EXPO_PUBLIC_API_BASE_URL=https://taejang.co.kr
EXPO_PUBLIC_EAS_PROJECT_ID=
# QA uses its own EAS project identity; never silently use the production ID.
EXPO_PUBLIC_EAS_PROJECT_ID_QA=
# Absolute or mobile-relative public Firebase client config for the selected package.
ANDROID_GOOGLE_SERVICES_FILE=
# true makes a push-ready build fail closed if either setting is missing.
TAEJANG_PUSH_CONFIG_REQUIRED=false
# Public operational controls are configured on the Netlify site, never here:
# MOBILE_LATEST_VERSION, MOBILE_LATEST_VERSION_CODE, MOBILE_MINIMUM_VERSION,
# MOBILE_MINIMUM_VERSION_CODE, MOBILE_FORCE_UPDATE, MOBILE_UPDATE_TITLE,
# MOBILE_UPDATE_MESSAGE, MOBILE_STORE_URL, MOBILE_RELEASE_NOTES_VERSION,
# MOBILE_RELEASE_NOTES, MOBILE_MAINTENANCE_MODE, MOBILE_MAINTENANCE_MESSAGE
