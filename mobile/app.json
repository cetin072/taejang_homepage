{
  "expo": {
    "name": "태장",
    "slug": "taejang-employee-mobile",
    "version": "0.1.2",
    "orientation": "portrait",
    "scheme": "taejangstaff",
    "icon": "./assets/taejang-launcher-icon.png",
    "splash": {
      "image": "./assets/taejang-launcher-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FDFCFD"
    },
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "com.cetin072.taejang.staff",
      "softwareKeyboardLayoutMode": "resize",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/taejang-adaptive-foreground.png",
        "backgroundColor": "#FDFCFD"
      }
    },
    "plugins": [
      "./plugins/with-release-upload-signing",
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "출근·퇴근 버튼을 누를 때 회사 도착 여부를 확인하기 위해 현재 위치를 사용합니다.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
