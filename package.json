{
  "name": "taejang-homepage",
  "private": true,
  "description": "Local development tooling for the Taejang homepage and work platform.",
  "scripts": {
    "build:netlify": "node scripts/build-netlify-publish.mjs",
    "test": "npm run test:platform-static && npm run test:public && npm run test:payroll",
    "test:platform-static": "node scripts/run-test-group.mjs platformStatic",
    "test:public": "node scripts/run-test-group.mjs publicHomepage",
    "test:staging-safety": "node scripts/run-test-group.mjs stagingSafety",
    "test:payroll": "node scripts/run-test-group.mjs payrollRegression",
    "test:payroll-hosted": "node tests/payroll-hosted-e2e.mjs",
    "test:erp": "node tests/erp-sales-isolated.mjs && node tests/erp-sales-amount-adjustments.mjs && node tests/erp-sales-browser.mjs",
    "test:article-editor": "node --test tests/promotion-document.test.mjs && node tests/promotion-visual-editor-browser.mjs"
  },
  "devDependencies": {
    "@tiptap/core": "3.34.0",
    "@tiptap/extension-image": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "esbuild": "0.28.2",
    "playwright": "^1.56.0",
    "supabase": "^2.116.0"
  }
}
